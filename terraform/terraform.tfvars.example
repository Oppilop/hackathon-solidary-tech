aws_region   = "us-east-1"
dr_region    = "us-west-2"
project      = "solidarytech"
cluster_name = "solidarytech-eks-prod"

# --- GitOps ---
gitops_repo_url = "https://github.com/SEU-USUARIO/hackathon-solidary-tech.git"
gitops_revision = "HEAD"

# --- FinOps ---
finops_project            = "SolidaryTech"
finops_environment        = "Production"
finops_cost_center        = "NGO-Core"
monthly_budget_usd        = 400
budget_notification_email = "plataforma@solidarytech.org"
enable_cost_guardrails    = true
enable_elasticache        = false

# --- Disaster Recovery ---
# Nome global: troque para algo único na sua conta e replique o mesmo valor em
# gitops/base/observability/08-velero.yaml.
velero_bucket_name       = "solidarytech-velero-backups"
db_backup_retention_days = 7

# --- Credenciais (AWS Academy) ---
# NUNCA commite este arquivo preenchido: terraform.tfvars está no .gitignore.
aws_access_key_id     = "..."
aws_secret_access_key = "..."
aws_session_token     = "..."

expose_argocd_lb = false
